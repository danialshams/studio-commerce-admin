# Required: configure on your host/Vercel, never commit real values.
DATABASE_URL=postgresql://crm:change-me@localhost:5432/daira_crm
SESSION_SECRET=generate-a-unique-64-character-secret
CRON_SECRET=generate-a-different-64-character-secret

# Optional email provider (leave unset until purchased/configured).
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Optional HTTPS SMS relay: POST JSON {to,from,body,requestId}; bearer API key.
# SMS_GATEWAY_URL=
# SMS_GATEWAY_API_KEY=
# SMS_SENDER=

# Optional electronic signature relay: POST JSON {requestId,signer,contract,callbackUrl}.
# SIGN_PROVIDER_URL=
# SIGN_PROVIDER_API_KEY=
# SIGN_WEBHOOK_SECRET=
# SIGN_CALLBACK_URL=https://your-domain.example/api/webhooks/signature
