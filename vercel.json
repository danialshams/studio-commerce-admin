{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/deliveries",
      "schedule": "5 6 * * *"
    }
  ],
  "buildCommand": "npm run migrate && npm run seed:showcase && npm run build"
}
