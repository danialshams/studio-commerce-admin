generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SiteType {
  STORE
  CORPORATE
}
enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}
enum OrderStatus {
  PENDING
  CONFIRMED
  PACKING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}
enum ContentStatus {
  DRAFT
  PUBLISHED
}

model Admin {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
  sessions Session[]
}
model Session {
  id String @id @default(cuid())
  adminId String
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin Admin @relation(fields:[adminId],references:[id],onDelete:Cascade)
  @@index([adminId,expiresAt])
}
model LoginAttempt {
  id String @id @default(cuid())
  key String
  createdAt DateTime @default(now())
  @@index([key,createdAt])
}
model StoreSettings {
  id String @id @default("main")
  siteType SiteType @default(STORE)
  themeId String @default("design-1")
  storeName String @default("فروشگاه من")
  description String @default("")
  logoUrl String?
  contactEmail String?
  contactPhone String?
  address String?
  instagram String?
  orderNoticeEmail String?
  seoTitle String?
  seoDescription String?
  homeSections Json @default("[]")
  editorialConfig Json?
  editorialDraft Json?
  updatedAt DateTime @updatedAt
}
model Category {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String @default("")
  imageUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products Product[]
}
model Product {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String @default("")
  sku String? @unique
  price Int
  comparePrice Int?
  inventory Int @default(0)
  lowStockAt Int @default(5)
  coverUrl String?
  gallery Json @default("[]")
  attributes Json @default("{}")
  featured Boolean @default(false)
  status ProductStatus @default(DRAFT)
  categoryId String?
  category Category? @relation(fields:[categoryId],references:[id],onDelete:SetNull)
  variants ProductVariant[]
  orderItems OrderItem[]
  reviews Review[]
  movements InventoryMovement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status,createdAt])
  @@index([categoryId])
}
model ProductVariant {
  id String @id @default(cuid())
  productId String
  label String
  sku String? @unique
  price Int?
  inventory Int @default(0)
  attributes Json @default("{}")
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  @@index([productId])
}
model InventoryMovement {
  id String @id @default(cuid())
  productId String
  delta Int
  reason String
  createdAt DateTime @default(now())
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  @@index([productId,createdAt])
}
model Customer {
  id String @id @default(cuid())
  fullName String
  email String? @unique
  phone String? @unique
  notes String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders Order[]
  reviews Review[]
}
model Order {
  id String @id @default(cuid())
  number Int @unique @default(autoincrement())
  customerId String?
  customerName String
  customerPhone String
  customerEmail String?
  shippingAddress Json @default("{}")
  shippingMethod String?
  shippingCost Int @default(0)
  subtotal Int
  discountTotal Int @default(0)
  total Int
  status OrderStatus @default(PENDING)
  note String @default("")
  trackingCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer? @relation(fields:[customerId],references:[id],onDelete:SetNull)
  items OrderItem[]
  payments Payment[]
  @@index([status,createdAt])
}
model OrderItem {
  id String @id @default(cuid())
  orderId String
  productId String?
  title String
  sku String?
  variantLabel String?
  imageUrl String?
  selectedOptions Json @default("{}")
  quantity Int
  unitPrice Int
  total Int
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  product Product? @relation(fields:[productId],references:[id],onDelete:SetNull)
}
model Payment {
  id String @id @default(cuid())
  orderId String
  provider String
  reference String? @unique
  amount Int
  status PaymentStatus @default(PENDING)
  createdAt DateTime @default(now())
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  @@index([status,createdAt])
}
model Coupon {
  id String @id @default(cuid())
  code String @unique
  type String @default("PERCENT")
  amount Int
  minSubtotal Int @default(0)
  usageLimit Int?
  usedCount Int @default(0)
  expiresAt DateTime?
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
}
model ShippingMethod {
  id String @id @default(cuid())
  title String
  cost Int @default(0)
  freeAbove Int?
  estimatedDays String?
  enabled Boolean @default(true)
}
model Review {
  id String @id @default(cuid())
  productId String
  customerId String?
  author String
  rating Int
  body String
  status ReviewStatus @default(PENDING)
  createdAt DateTime @default(now())
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  customer Customer? @relation(fields:[customerId],references:[id],onDelete:SetNull)
  @@index([status,createdAt])
}
model Page {
  id String @id @default(cuid())
  title String
  slug String @unique
  body String @default("")
  seoTitle String?
  seoDescription String?
  status ContentStatus @default(DRAFT)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
model Article {
  id String @id @default(cuid())
  title String
  slug String @unique
  summary String @default("")
  body String @default("")
  coverUrl String?
  seoTitle String?
  seoDescription String?
  status ContentStatus @default(DRAFT)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
model Banner {
  id String @id @default(cuid())
  target Json?
  title String
  subtitle String @default("")
  imageUrl String?
  linkUrl String?
  position Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
}
model Service {
  id String @id @default(cuid())
  title String
  slug String @unique
  description String @default("")
  imageUrl String?
  active Boolean @default(true)
}
model PortfolioProject {
  id String @id @default(cuid())
  title String
  description String @default("")
  imageUrl String?
  linkUrl String?
  active Boolean @default(true)
}
model Lead {
  id String @id @default(cuid())
  name String
  phone String
  email String?
  subject String?
  message String
  status String @default("NEW")
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(cuid())
  resource String
  resourceId String
  operation String
  detail Json @default("{}")
  createdAt DateTime @default(now())
  @@index([resource,createdAt])
}
